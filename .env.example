# ===================================================================
#  .env 양식  —  이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우십시오
#
#  ※ .env 는 저장소에 올라가지 않습니다. 컴퓨터마다 직접 만듭니다.
#  ※ 키를 카톡·메일로 옮기지 마십시오. 각 콘솔에서 새로 발급받는 게 낫습니다.
#  ※ 컴퓨터별로 키를 따로 발급하면(home / academy), 한쪽에 문제가 생겨도
#     그 키만 폐기하면 됩니다.
#  ※ 아이디·비밀번호는 여기 넣지 않습니다. 아래 4개만.
# ===================================================================


# -------------------------------------------------------------------
# 1. Supabase   →  프로젝트 → Settings(톱니바퀴) → API Keys
# -------------------------------------------------------------------

# "Project URL". https://xxxxx.supabase.co 형태. 공개 값이라 그대로 복사.
SUPABASE_URL=

# "Publishable key". sb_publishable_ 로 시작. 공개 값이라 그대로 복사.
SUPABASE_ANON_KEY=

# "Secret key". sb_secret_ 로 시작.
# 컴퓨터마다 새로 만드십시오 (Create new secret key → 이름 academy 등).
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------------------------------
# 2. Anthropic   →  console.anthropic.com → API Keys → Create Key
#    ※ 만든 직후 한 번만 보입니다. 바로 아래에 붙여넣고 저장하십시오.
#    ※ 컴퓨터마다 따로 발급 (이름 academy 등).
# -------------------------------------------------------------------

ANTHROPIC_API_KEY=


# ===================================================================
#  다 채운 뒤 확인:   python tools/check_env.py
#  (키 값은 화면에 출력되지 않습니다)
# ===================================================================
