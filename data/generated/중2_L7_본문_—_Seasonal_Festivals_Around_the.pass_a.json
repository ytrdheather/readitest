        17,
        11,
        27
      ],
      "options": [
        {
          "label": "①",
          "body": "Surprisingly, the fallas are burned on the last day of the festival.",
          "is_answer": false,
          "violates_point_code": null,
          "via_modification": null,
          "ordinal": 1
        },
        {
          "label": "②",
          "body": "Burning them symbolizes saying goodbye to old things and hello to a new start.",
          "is_answer": false,
          "violates_point_code": null,
          "via_modification": null,
          "ordinal": 2
        },
