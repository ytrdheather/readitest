      ],
      "options": [
        {
          "label": "①",
          "body": "At 2 p.m. on March 1, Dr. Schofield was hiding in a building and saw a large group of people gathering outside.",
          "is_answer": false,
          "violates_point_code": null,
          "via_modification": null,
          "ordinal": 1
        },
        {
          "label": "②",
          "body": "He studied so hard that he was able to teach in Korean after only a few years.",
          "is_answer": false,
          "violates_point_code": null,
          "via_modification": null,
          "ordinal": 2
        },
        {
          "label": "③",
          "body": "He believed that every country have the right to be independent, so he helped the Korean independence movement.",
          "is_answer": true,
          "violates_point_code": "VERB_SVA",
          "via_modification": "EI_AGREEMENT",
          "ordinal": 3
        },
        {
          "label": "④",
          "body": "He then wrote an article about the historic event and sent it to foreign newspapers with his pictures.",
          "is_answer": false,
          "violates_point_code": null,
          "via_modification": null,
          "ordinal": 4
        },
